#!/bin/bash
# nouveau-pstate-daemon: load-based pstate switcher for NVAC (MCP79/9400M)
#
# Reads nouveau MSI IRQ rate from /proc/interrupts every SAMPLE_INTERVAL seconds.
# Switches between PSTATE_IDLE and PSTATE_LOAD with hysteresis.
# 03 and 0e on this NVAC share Voltage 0.90V (per VBIOS perf table) — voltage-
# neutral transitions only, no Voltage-GPIO programming involved.

set -u

: "${SAMPLE_INTERVAL:=2}"
: "${UP_THRESHOLD:=100}"
: "${UP_HOLD:=2}"
: "${DOWN_THRESHOLD:=80}"
: "${DOWN_HOLD:=8}"
: "${PSTATE_LOAD:=0e}"
: "${PSTATE_IDLE:=03}"
: "${PSTATE_FILE:=/sys/kernel/debug/dri/0/pstate}"
: "${IRQ_NAME:=nvkm}"
: "${LOG_FILE:=/var/log/nouveau-pstate.log}"
: "${STATE_FILE:=/run/nouveau-pstate.state}"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

read_irq_count() {
    awk -v n="$IRQ_NAME" '$0 ~ n {print $2; exit}' /proc/interrupts
}

publish_state() {
    local p=$1
    local tmp="${STATE_FILE}.tmp"
    if printf '%s\n' "$p" > "$tmp" 2>/dev/null; then
        chmod 644 "$tmp" 2>/dev/null
        mv -f "$tmp" "$STATE_FILE" 2>/dev/null
    fi
}

set_pstate() {
    local p=$1
    if [[ -w "$PSTATE_FILE" ]]; then
        echo "$p" > "$PSTATE_FILE"
        publish_state "$p"
        log "pstate -> $p"
    else
        log "ERROR: $PSTATE_FILE not writable"
        return 1
    fi
}

cleanup() {
    log "stopping, restoring pstate $PSTATE_LOAD"
    set_pstate "$PSTATE_LOAD" 2>/dev/null
    rm -f "$STATE_FILE" 2>/dev/null
    exit 0
}
trap cleanup SIGTERM SIGINT SIGHUP

if [[ ! -f "$PSTATE_FILE" ]]; then
    log "FATAL: $PSTATE_FILE missing — nouveau debugfs not mounted?"
    exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"
log "starting (sample=${SAMPLE_INTERVAL}s up>=${UP_THRESHOLD}/${UP_HOLD} down<=${DOWN_THRESHOLD}/${DOWN_HOLD} load=$PSTATE_LOAD idle=$PSTATE_IDLE)"

current_pstate=$PSTATE_LOAD
set_pstate "$current_pstate"

prev_count=$(read_irq_count)
[[ -z "$prev_count" ]] && { log "FATAL: no IRQ counter for '$IRQ_NAME'"; exit 1; }

up_count=0
down_count=0
skip_next=0

while true; do
    sleep "$SAMPLE_INTERVAL"
    now_count=$(read_irq_count)
    [[ -z "$now_count" ]] && continue
    delta=$(( now_count - prev_count ))
    prev_count=$now_count
    rate=$(( delta / SAMPLE_INTERVAL ))

    if (( skip_next )); then
        skip_next=0
        continue
    fi

    if (( rate >= UP_THRESHOLD )); then
        up_count=$((up_count + 1))
        down_count=0
        if (( up_count >= UP_HOLD )) && [[ "$current_pstate" != "$PSTATE_LOAD" ]]; then
            set_pstate "$PSTATE_LOAD"
            current_pstate=$PSTATE_LOAD
            up_count=0
            skip_next=1
        fi
    elif (( rate <= DOWN_THRESHOLD )); then
        down_count=$((down_count + 1))
        up_count=0
        if (( down_count >= DOWN_HOLD )) && [[ "$current_pstate" != "$PSTATE_IDLE" ]]; then
            set_pstate "$PSTATE_IDLE"
            current_pstate=$PSTATE_IDLE
            down_count=0
            skip_next=1
        fi
    else
        up_count=0
        down_count=0
    fi
done
